# Copy this file to .env and fill in your real values.

APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos

# Leave blank if you run the app exactly as documented:
#   php -S localhost:8009 -t public
# Only set this if your web server's document root is NOT the "public"
# folder (e.g. you deployed the whole project into an Apache/XAMPP htdocs
# folder instead of pointing the vhost at "public"). In that case set this
# to whatever prefix reaches the public folder in your browser, e.g.:
#   APP_BASE_PATH=/sales-inventory-system/public
# This fixes broken image/asset/API links caused by a mismatched document root.
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sales_inventory
DB_USER=root
DB_PASS=

# Generate a long random string for production, e.g. `php -r "echo bin2hex(random_bytes(32));"`
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# Optional: leave blank to use the built-in rule-based fallback for the AI Insights widget
GEMINI_API_KEY=

UPLOAD_DIR=

# --- Email notifications ---------------------------------------------------
# Uses PHP's built-in mail() function. On most local Windows/XAMPP setups
# there's no real mail server configured, so if sending fails (or MAIL_LOG_ONLY
# is true) emails are written to storage/mail_log.txt instead of being lost —
# open that file to see exactly what would have been sent.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Sales & Inventory System
MAIL_LOG_ONLY=true

# --- Full public URL (needed for Flutterwave's redirect_url) ---------------
# e.g. https://yourapp.com  or  http://localhost:8009  (no trailing slash)
APP_URL=http://localhost:8009

# --- Flutterwave (subscription billing + online store checkout) ------------
# Get these from your Flutterwave dashboard (Settings -> API Keys).
# Leave FLW_SECRET_KEY blank to use the built-in "simulated payment" flow for
# local development/testing — the app detects this automatically and shows a
# "Simulate Successful Payment" button instead of a real Flutterwave checkout.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Set this to the SAME "secret hash" you configure in your Flutterwave
# dashboard's webhook settings, so incoming webhooks can be verified.
FLW_WEBHOOK_HASH=

